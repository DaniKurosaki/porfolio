---
import SectionLabel from "@/components/motion/SectionLabel.astro";
import ScrubWords from "@/components/motion/ScrubWords.astro";
import RevealLines from "@/components/motion/RevealLines.astro";
import RevealImage from "@/components/motion/RevealImage.astro";
import Roll from "@/components/motion/Roll.astro";
import FadeUp from "@/components/motion/FadeUp.astro";
import { CAPITULOS, PERFIL } from "@/data/perfil";
import { EXPERIENCIA } from "@/data/experiencia";
import { TEXTOS } from "@/data/textos";

const t = TEXTOS.manifiesto;
// La última fila de la ficha es el puesto actual, sacado de la experiencia.
const actual = EXPERIENCIA.find((p) => p.actual);
const ficha: { clave: string; valor: string; actual?: boolean }[] = [
	...t.ficha,
	...(actual ? [{ clave: t.ahora, valor: `${actual.puesto} en ${actual.empresa.replace(/ S\.A\.$/, "")}`, actual: true }] : []),
];
// El capítulo que viene después: la composición acaba con un enlace a él.
const siguiente = CAPITULOS[1];
---

<!--
	Capítulo 01, el manifiesto. Una frase grande cuyas palabras se encienden al ritmo del
	scroll (ScrubWords) y, debajo, el retrato a la izquierda (la foto se desplaza dentro de su
	marco con RevealImage) y a la derecha, alineados arriba, el relato y una ficha técnica que
	acaba en el puesto actual, con el enlace al capítulo siguiente al pie de la foto. Sin JS o
	con movimiento reducido, la frase está sólida y todo quieto; en móvil se apila.
-->
<section
	id="manifiesto"
	data-chapter="01"
	class="relative overflow-x-clip bg-ink pb-32 pt-28 text-paper md:pb-40 md:pt-36 lg:pb-52 lg:pt-44"
>
	<div class="shell">
		<SectionLabel index="01" text="Manifiesto" />

		<!-- La primera línea entra dos columnas: sangría de 2/12 de la rejilla (columna + hueco). -->
		<ScrubWords
			class="display mt-12 text-[length:clamp(2.375rem,6vw,6.5rem)] leading-[0.92] md:mt-16 lg:mt-20 lg:indent-[calc((100%_+_1.25rem)/6)]"
		>
			{t.frase}
		</ScrubWords>

		<div class="mt-20 grid grid-cols-12 gap-x-5 gap-y-16 md:mt-28 lg:mt-36">
			<!-- El retrato, alineado arriba con el relato; solo la foto se mueve dentro de su marco. -->
			<div class="col-span-12 sm:col-span-8 md:col-span-6 lg:col-span-4">
				<figure>
					<RevealImage
						src="/photo.png"
						alt={t.fotoAlt}
						width={1600}
						height={1600}
						class="aspect-[3/4] w-full bg-ink-2"
					/>
					<figcaption class="text-label mt-4 flex items-center gap-3 text-paper/50">
						<span>Fig. 01</span>
						<span class="h-px w-6 bg-current opacity-40" aria-hidden="true"></span>
						<span>{PERFIL.nombre}</span>
					</figcaption>
				</figure>
			</div>

			<!-- El relato arriba y el enlace al siguiente capítulo al pie, a la altura del pie de foto. -->
			<div class="col-span-12 flex flex-col justify-between gap-16 lg:col-span-7 lg:col-start-6">
				<div>
					<RevealLines as="p" class="max-w-[38ch] text-xl leading-snug text-paper/80 md:text-2xl">
						{t.parrafo}
					</RevealLines>

					<!-- La ficha técnica: lo esencial de un vistazo, con filetes como en un plano. -->
					<FadeUp as="dl" stagger={0.08} class="mt-14 border-b border-paper/15 lg:mt-20">
						{
							ficha.map((fila) => (
								<div class="grid grid-cols-12 gap-x-5 gap-y-2 border-t border-paper/15 py-5">
									<dt class="text-label col-span-12 flex items-center gap-3 text-paper/50 sm:col-span-4">
										<span class="size-[5px] shrink-0 bg-current" aria-hidden="true" />
										{fila.clave}
									</dt>
									<dd class:list={["col-span-12 text-lg sm:col-span-8", fila.actual ? "text-paper" : "text-paper/80"]}>
										{fila.actual && <span class="led led-pulse mr-3 align-middle" aria-hidden="true" />}
										{fila.valor}
									</dd>
								</div>
							))
						}
					</FadeUp>
				</div>

				<a
					href={`#${siguiente.id}`}
					class="text-label group flex items-center gap-4 text-paper/50 transition-colors duration-500 hover:text-paper"
				>
					<span class="size-[7px] shrink-0 rounded-full border border-current" aria-hidden="true"></span>
					<span class="h-px flex-1 bg-current opacity-30" aria-hidden="true"></span>
					<Roll text={`(${siguiente.indice}) ${siguiente.nombre}`} />
					<svg
						class="h-4 w-4 shrink-0"
						viewBox="0 0 20 20"
						fill="none"
						stroke="currentColor"
						stroke-width="1"
						aria-hidden="true"
					>
						<path d="M10 1 V18 M4 12 L10 18 L16 12" vector-effect="non-scaling-stroke"></path>
					</svg>
				</a>
			</div>
		</div>
	</div>
</section>
