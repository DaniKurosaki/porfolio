---
import SectionLabel from "@/components/motion/SectionLabel.astro";
import RevealLines from "@/components/motion/RevealLines.astro";
import { TEXTOS } from "@/data/textos";

const t = TEXTOS.origen;
const dos = (n: number) => String(n).padStart(2, "0");
const total = dos(t.pasos.length);

// La cabecera del editor lleva el selector del componente; la línea «caliente» es la que enciende el led.
const selector = t.codigo.join("\n").match(/selector:\s*'([^']+)'/)?.[1] ?? "U1";
const caliente = t.codigo.findIndex((linea) => linea.includes(".set(true)"));

/* ── El esquema ──────────────────────────────────────────────────────────────
   Una lámina técnica en un viewBox de 760 × 560: pila (B1), tres resistencias (R1–R3),
   un condensador (C1), el chip (U1) y el led (D1), con pistas de quiebros a 45°, vías y
   pads. Se pinta tres veces desde aquí: en el escenario fijado, en la columna (paso 1) y
   recortado alrededor del led ya encendido (paso 3). */
type Punto = [number, number];
interface Etiqueta {
	x: number;
	y: number;
	t: string;
	ancla?: "start" | "middle" | "end";
	tenue?: boolean;
	escala?: number;
}
interface Dibujo {
	/** Tamaño de las referencias (R1, C1…) en unidades del viewBox. */
	letra: number;
	/** Ganchos del escenario fijado: `data-dip` (se apaga al invertir el fondo) y `data-pistas` (se desvanece). */
	escena?: boolean;
	/** Si lleva la corriente encendida (amarilla), la x desde la que sale hacia el led. */
	corriente?: number;
}

const ANCHO = 760;
const ALTO = 560;
const CHIP = { x: 280, y: 196, w: 160, h: 136 };
const LED: Punto = [660, 393];
const LED_D = 20; // diámetro del brillo, en unidades del viewBox
// Dónde acaba el panel del editor dentro de la placa (en %): tapa el chip y deja fuera R1, el led y las masas.
const PANEL = { left: 4, top: 15, width: 74, height: 70 };
// El recorte del paso 3 en columna: el led, R2 y la vuelta a masa.
const RECORTE = { x: 440, y: 210, w: 320, h: 310 };

const pct = (v: number) => `${Number(v.toFixed(3))}%`;
// El panel arranca recortado justo al cuerpo del chip y crece hasta su caja: inset() en % del panel.
const desdeChip = `inset(${[
	((CHIP.y / ALTO) * 100 - PANEL.top) / PANEL.height,
	(PANEL.left + PANEL.width - ((CHIP.x + CHIP.w) / ANCHO) * 100) / PANEL.width,
	(PANEL.top + PANEL.height - ((CHIP.y + CHIP.h) / ALTO) * 100) / PANEL.height,
	((CHIP.x / ANCHO) * 100 - PANEL.left) / PANEL.width,
]
	.map((v) => pct(v * 100))
	.join(" ")})`;
const panelEstilo = `left:${pct(PANEL.left)};top:${pct(PANEL.top)};width:${pct(PANEL.width)};height:${pct(PANEL.height)};font-size:2.15cqw`;
// La corriente del escenario sale justo por el borde derecho del panel.
const bordePanel = Math.ceil(((PANEL.left + PANEL.width) / 100) * ANCHO);

// El brillo del led, colocado en % de su caja; el margen (en % del ancho, también el de arriba) lo centra.
const brillo = (caja: { x: number; y: number; w: number; h: number }) => {
	const d = (LED_D / caja.w) * 100;
	return `left:${pct(((LED[0] - caja.x) / caja.w) * 100)};top:${pct(((LED[1] - caja.y) / caja.h) * 100)};width:${pct(d)};margin:${pct(-d / 2)} 0 0 ${pct(-d / 2)}`;
};
const brilloEscena = brillo({ x: 0, y: 0, w: ANCHO, h: ALTO });
const brilloRecorte = brillo(RECORTE);

/** Una resistencia en zigzag entre dos puntos alineados en horizontal o en vertical. */
function zigzag(x1: number, y1: number, x2: number, y2: number, picos: number, amp = 10) {
	const horizontal = y1 === y2;
	const paso = (horizontal ? x2 - x1 : y2 - y1) / picos;
	const puntos: Punto[] = [[x1, y1]];
	for (let i = 0; i < picos; i++) {
		const d = (i + 0.5) * paso;
		const s = i % 2 === 0 ? -amp : amp;
		puntos.push(horizontal ? [x1 + d, y1 + s] : [x1 + s, y1 + d]);
	}
	puntos.push([x2, y2]);
	return puntos;
}
const R1 = zigzag(150, 56, 230, 56, 8);
const R3 = zigzag(560, 110, 560, 190, 8);
const R2 = zigzag(660, 300, 660, 360, 6);
const comoPuntos = (p: Punto[]) => p.map(([x, y]) => `${x},${y}`).join(" ");
const comoTramo = (p: Punto[]) => p.map(([x, y]) => `L${x} ${y}`).join(" ");

function circuito({ letra, escena = false, corriente }: Dibujo) {
	const ve = 'vector-effect="non-scaling-stroke" pathLength="1"';
	const trazo = (d: string, ancho = 1) =>
		`<path data-trazo d="${d}" ${ve}${ancho === 1 ? "" : ` stroke-width="${ancho}"`}/>`;
	const zig = (p: Punto[]) => `<polyline data-trazo points="${comoPuntos(p)}" ${ve} stroke-width="1.25"/>`;
	const via = ([x, y]: Punto) => `<circle data-trazo cx="${x}" cy="${y}" r="3.5" ${ve}/>`;
	const pad = ([x, y]: Punto) =>
		`<rect data-pad x="${x - 3}" y="${y - 3}" width="6" height="6" fill="currentColor" stroke="none"/>`;
	const texto = ({ x, y, t: s, ancla = "start", tenue = false, escala = 1 }: Etiqueta) =>
		`<text data-etiqueta x="${x}" y="${y}" text-anchor="${ancla}"${tenue ? ' fill-opacity="0.55"' : ""}${escala === 1 ? "" : ` font-size="${letra * escala}"`}>${s}</text>`;

	// En el orden en que se dibujan: de la pila, por el chip, hasta el led y la vuelta a masa.
	const trazos = [
		// B1, la pila: dos celdas (placa larga +, corta −).
		trazo("M50 246 H94 M61 258 H83 M50 270 H94 M61 282 H83", 1.5),
		trazo("M72 246 V100 L116 56 H150"),
		zig(R1),
		trazo("M230 56 H540 L560 76 V110"),
		via([240, 56]),
		trazo("M240 56 V200 L262 222"),
		via([240, 140]),
		trazo("M240 140 H176 V246"),
		// C1, el condensador.
		trazo("M160 246 H192 M160 258 H192", 1.5),
		trazo("M176 258 V504"),
		// U1, el chip con su muesca y sus seis patillas.
		trazo(
			`M${CHIP.x} ${CHIP.y} H350 A10 10 0 0 0 370 ${CHIP.y} H${CHIP.x + CHIP.w} V${CHIP.y + CHIP.h} H${CHIP.x} Z`,
			1.25,
		),
		trazo("M262 222 H280 M262 264 H280 M262 306 H280 M440 222 H458 M440 264 H458 M440 306 H458"),
		zig(R3),
		trazo("M560 190 V200 L538 222 H458"),
		trazo("M458 264 H630 L660 294 V300"),
		zig(R2),
		trazo("M660 360 V384"),
		// D1, el led: triángulo, barra y las dos flechas de emisión.
		trazo("M644 384 H676 L660 410 Z M644 410 H676", 1.5),
		trazo("M682 380 L698 364 M691 364 H698 V371 M690 392 L706 376 M699 376 H706 V383"),
		trazo("M660 410 V460 L616 504"),
		via([616, 504]),
		trazo("M72 282 V460 L116 504 H616"),
		via([176, 504]),
		via([240, 504]),
		trazo("M262 306 H240 V504"),
		trazo("M240 504 V516 M226 516 H254 M231 523 H249 M236 530 H244"),
		trazo("M458 306 H496.5"),
		via([500, 306]),
		// La cota de R1.
		trazo("M150 30 V40 M230 30 V40 M150 35 H230"),
	];
	const pads = [
		...([
			[150, 56],
			[230, 56],
			[560, 110],
			[560, 190],
			[660, 300],
			[660, 360],
		] as Punto[]).map(pad),
		// La marca de la patilla 1 del chip.
		`<circle data-pad cx="${CHIP.x + 12}" cy="${CHIP.y + 14}" r="2.5" fill="currentColor" stroke="none"/>`,
	];
	const etiquetas: Etiqueta[] = [
		{ x: 44, y: 250, t: "+", ancla: "end" },
		{ x: 44, y: 286, t: "−", ancla: "end" },
		{ x: 102, y: 262, t: "B1" },
		{ x: 102, y: 278, t: "9V", tenue: true },
		{ x: 190, y: 22, t: "R1 · 220Ω", ancla: "middle" },
		{ x: 420, y: 46, t: "VCC", ancla: "middle", tenue: true },
		{ x: 198, y: 250, t: "C1" },
		{ x: 198, y: 266, t: "100µF", tenue: true },
		{ x: CHIP.x + CHIP.w / 2, y: CHIP.y + CHIP.h / 2 + 6, t: "U1", ancla: "middle", escala: 1.5 },
		{ x: 578, y: 146, t: "R3" },
		{ x: 578, y: 162, t: "10kΩ", tenue: true },
		{ x: 680, y: 326, t: "R2" },
		{ x: 680, y: 342, t: "1kΩ", tenue: true },
		{ x: 636, y: 401, t: "D1", ancla: "end" },
		{ x: 258, y: 530, t: "GND", tenue: true },
	];

	const esquinas = `<path d="M8 22 V8 H22 M738 8 H752 V22 M752 538 V552 H738 M22 552 H8 V538" vector-effect="non-scaling-stroke" opacity="0.4"/>`;
	const textos = `<g font-family="JetBrains Mono Variable, ui-monospace, monospace" font-size="${letra}" letter-spacing="0.04em" fill="currentColor" stroke="none">${etiquetas.map(texto).join("")}</g>`;
	const luz =
		corriente === undefined
			? ""
			: `<path data-corriente d="M${corriente} 264 H630 L660 294 V300 ${comoTramo(R2.slice(1))} V384 M660 410 V460 L616 504 H500" ${ve} stroke-width="1.5" style="stroke: rgb(var(--volt))"/>`;

	return `<g${escena ? " data-dip" : ""}>${esquinas}<g${escena ? " data-pistas" : ""}>${trazos.join("")}${pads.join("")}${textos}</g></g>${luz}`;
}

const esquemaEscena = circuito({ letra: 13, escena: true, corriente: bordePanel });
const esquemaColumna = circuito({ letra: 16 });
const esquemaRecorte = circuito({ letra: 12, corriente: 458 });
---

<!--
	Capítulo 02, «Del circuito al código»: la escena insignia. En escritorio la sección se
	fija unas tres pantallas y el scroll cuenta la historia en tres tiempos: el esquema se
	dibuja, el chip se abre en un editor donde se teclea el componente, y al llegar a
	`encendido.set(true)` el led se enciende y todo el capítulo pasa de papel a tinta. Sin
	JS, con movimiento reducido o por debajo de 1024 px (o de 600 px de alto), los tres
	pasos se leen en columna, cada uno con su lámina: el esquema, el código y el led
	encendido, sobre papel.
-->
<section id="sobre-mi" data-chapter="02" data-origen class="group/pin on-paper relative overflow-x-clip bg-paper text-ink">
	<div data-stage class="relative group-data-[pinned]/pin:h-[100svh]">
		<div
			class="shell py-28 md:py-36 lg:py-44 group-data-[pinned]/pin:grid group-data-[pinned]/pin:h-full group-data-[pinned]/pin:grid-cols-12 group-data-[pinned]/pin:gap-x-5 group-data-[pinned]/pin:py-0"
		>
			<!-- Texto: etiqueta, titular, indicador y los tres pasos (superpuestos con el escenario). -->
			<div
				class="group-data-[pinned]/pin:col-span-5 group-data-[pinned]/pin:flex group-data-[pinned]/pin:h-full group-data-[pinned]/pin:flex-col group-data-[pinned]/pin:pb-12 group-data-[pinned]/pin:pt-28"
			>
				<div data-dip>
					<SectionLabel index="02" text="Origen" />
				</div>

				<RevealLines
					as="h2"
					data-dip
					class="display mt-10 text-huge md:mt-14 group-data-[pinned]/pin:mt-8 group-data-[pinned]/pin:text-[length:clamp(3rem,5.6vw,6.5rem)]"
				>
					{t.titulo.antes}{" "}<em class="accent" data-acento>{t.titulo.acento}</em>
				</RevealLines>

				<!-- Indicador del paso activo: solo en el escenario (lo actualiza el script). -->
				<p
					data-dip
					aria-hidden="true"
					class="text-label mt-auto hidden items-center gap-3 tabular-nums text-ink/60 group-data-[pinned]/pin:flex"
				>
					<span data-step-index class="text-ink">01</span>
					<span>/ {total}</span>
					<span class="relative block h-px w-16 bg-ink/20">
						<span data-progress class="absolute inset-0 origin-left bg-ink"></span>
					</span>
					<span data-step-key>{t.pasos[0].clave}</span>
				</p>

				<ol
					class="mt-16 flex flex-col gap-24 md:mt-24 lg:gap-32 group-data-[pinned]/pin:mt-6 group-data-[pinned]/pin:grid group-data-[pinned]/pin:gap-0"
				>
					{
						t.pasos.map((paso, i) => (
							<li
								data-step
								data-key={paso.clave}
								class="lg:grid lg:grid-cols-12 lg:items-center lg:gap-x-5 group-data-[pinned]/pin:block group-data-[pinned]/pin:[grid-area:1/1]"
							>
								<div data-step-text class="lg:col-span-5">
									<p class="text-label flex items-center gap-3 tabular-nums text-ink/60 group-data-[pinned]/pin:hidden">
										<span class="text-ink">{dos(i + 1)}</span>
										<span>/ {total}</span>
										<span class="h-px w-8 bg-current opacity-40" aria-hidden="true" />
										<span>{paso.clave}</span>
									</p>
									<h3 class="display mt-5 text-big group-data-[pinned]/pin:mt-0 group-data-[pinned]/pin:text-[length:clamp(1.75rem,2.8vw,3.25rem)]">
										{paso.titulo}
									</h3>
									<p class="mt-5 max-w-[42ch] text-lg text-ink/70 md:text-xl group-data-[pinned]/pin:text-lg">
										{paso.texto}
									</p>
								</div>

								{/* La lámina de cada paso, solo en columna: en el escenario la sustituye la placa. */}
								<div class="mt-10 lg:col-span-6 lg:col-start-7 lg:mt-0 group-data-[pinned]/pin:hidden">
									{i === 0 && (
										<figure data-col-esquema>
											<svg
												viewBox={`0 0 ${ANCHO} ${ALTO}`}
												class="h-auto w-full"
												role="img"
												aria-label={t.esquemaAlt}
												fill="none"
												stroke="currentColor"
												stroke-width="1"
												set:html={esquemaColumna}
											/>
											<figcaption class="text-label mt-4 text-ink/50">Fig. 02</figcaption>
										</figure>
									)}
									{i === 1 && (
										<div data-col-codigo class="bg-ink-2 text-paper">
											<div class="text-label flex items-center justify-between gap-4 border-b border-paper/10 px-4 py-3 text-paper/50 sm:px-6">
												<span class="flex items-center gap-2">
													<span class="size-[7px] rounded-full border border-current" aria-hidden="true" />
													U1
												</span>
												<span>{selector}</span>
											</div>
											<code class="block overflow-x-auto px-4 py-4 font-mono text-[11px] leading-[1.7] sm:px-6 sm:py-5 sm:text-[13px]">
												{t.codigo.map((linea, n) => (
													<span class:list={["flex", n === caliente ? "text-volt" : "text-paper/85"]}>
														<span aria-hidden="true" class="w-[2ch] shrink-0 select-none text-right text-paper/30">
															{n + 1}
														</span>
														<span data-code-text class="ml-[2ch] inline-block whitespace-pre">
															{linea}
														</span>
													</span>
												))}
											</code>
										</div>
									)}
									{i === 2 && (
										<div data-col-led class="recorte relative max-w-md bg-ink-2 text-paper/45">
											<svg
												viewBox={`${RECORTE.x} ${RECORTE.y} ${RECORTE.w} ${RECORTE.h}`}
												class="absolute inset-0 h-full w-full"
												aria-hidden="true"
												fill="none"
												stroke="currentColor"
												stroke-width="1"
												set:html={esquemaRecorte}
											/>
											<span data-brillo class="brillo" style={brilloRecorte} aria-hidden="true" />
										</div>
									)}
								</div>
							</li>
						))
					}
				</ol>
			</div>

			<!-- El escenario visual (solo con data-pinned): la placa con el esquema, el brillo del led y el editor. -->
			<div
				class="hidden group-data-[pinned]/pin:col-span-7 group-data-[pinned]/pin:col-start-6 group-data-[pinned]/pin:flex group-data-[pinned]/pin:items-center group-data-[pinned]/pin:justify-center group-data-[pinned]/pin:pb-10 group-data-[pinned]/pin:pt-24"
			>
				<div data-board class="placa relative">
					<p data-dip aria-hidden="true" class="text-label absolute -top-8 left-0 text-ink/50">Fig. 02</p>
					<svg
						viewBox={`0 0 ${ANCHO} ${ALTO}`}
						class="absolute inset-0 h-full w-full overflow-visible"
						role="img"
						aria-label={t.esquemaAlt}
						fill="none"
						stroke="currentColor"
						stroke-width="1"
						set:html={esquemaEscena}
					/>
					<span data-brillo class="brillo" style={brilloEscena} aria-hidden="true"></span>

					<!-- El editor en que se convierte el chip (lo recorta el script al cuerpo de U1 y lo abre). -->
					<div
						data-editor
						data-desde={desdeChip}
						class="absolute flex flex-col border border-paper/15 bg-ink-2 font-mono text-paper"
						style={panelEstilo}
					>
						<div
							data-editor-head
							class="flex items-center justify-between border-b border-paper/10 px-[1.4em] py-[0.9em] text-[0.7em] uppercase leading-none tracking-[0.14em] text-paper/50"
						>
							<span class="flex items-center gap-[0.8em]">
								<span data-editor-led class="block size-[0.8em] rounded-full border border-current" aria-hidden="true"></span>
								U1
							</span>
							<span>{selector}</span>
						</div>
						<code class="block flex-1 px-[1.4em] py-[1.1em] leading-[1.6]">
							{
								t.codigo.map((linea, n) => (
									<span data-code-line data-code-hot={n === caliente ? "" : undefined} class="flex text-paper/85">
										<span data-code-num aria-hidden="true" class="w-[2ch] shrink-0 select-none text-right text-paper/30">
											{n + 1}
										</span>
										<span data-code-text class="ml-[2ch] inline-block whitespace-pre">
											{linea}
										</span>
									</span>
								))
							}
						</code>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* El acento del titular: tinta sobre papel y amarillo cuando el capítulo se enciende
	   (el script anima --o-acento). Gana a `.on-paper .accent`. */
	[data-origen] [data-acento] {
		color: rgb(var(--o-acento, var(--ink)));
	}

	/* La placa del escenario: la proporción del esquema, tan grande como deje el alto. Es un
	   contenedor para que el editor y el brillo midan en cqw y escalen con ella. */
	.placa {
		container-type: inline-size;
		aspect-ratio: 760 / 560;
		width: min(100%, calc((100svh - 11rem) * 760 / 560));
	}

	/* El recorte del led encendido (paso 3 en columna). */
	.recorte {
		container-type: inline-size;
		aspect-ratio: 320 / 310;
	}

	/* El led encendido: un punto amarillo con su halo. Se coloca con left/top/width/margin
	   en % (el margen centra sin transform, que es del script). */
	.brillo {
		position: absolute;
		aspect-ratio: 1;
		border-radius: 9999px;
		background: rgb(var(--volt));
		box-shadow:
			0 0 1cqw 0.3cqw rgb(var(--volt) / 0.9),
			0 0 5cqw 1.5cqw rgb(var(--volt) / 0.45),
			0 0 14cqw 4cqw rgb(var(--volt) / 0.18);
		pointer-events: none;
	}
</style>

<script>
	import { EASE, MQ, ScrollTrigger, gsap } from "@/scripts/motion";

	const root = document.querySelector<HTMLElement>("#sobre-mi");

	// El escenario necesita espacio: en escritorio y con al menos 600 px de alto. Si no, columna.
	const ESCENA = `${MQ.desktop} and (min-height: 600px)`;
	const COLUMNA = `${MQ.mobile}, ${MQ.motion} and (max-height: 599px)`;

	/** Los canales RGB de un token del sistema visual («10 10 10» → [10, 10, 10]). */
	const canales = (token: string) =>
		getComputedStyle(document.documentElement).getPropertyValue(token).trim().split(/\s+/).map(Number);
	const rgba = (c: number[], a = 1) => `rgba(${c.join(",")},${a})`;
	const mezcla = (a: number[], b: number[], p: number) => a.map((v, i) => Math.round(v + (b[i] - v) * p)).join(" ");

	/** Teclea una línea de código: el recorte avanza de carácter en carácter (la fuente es monoespaciada). */
	const teclear = (tl: gsap.core.Timeline, texto: Element, en: number, porCaracter: number) => {
		const n = Math.max(1, texto.textContent?.length ?? 1);
		tl.to(texto, { clipPath: "inset(0% 0% 0% 0%)", ease: `steps(${n})`, duration: n * porCaracter }, en);
		return n * porCaracter;
	};

	/** El parpadeo del led al encenderse (un array nuevo cada vez: GSAP hace suyos los fotogramas). */
	const parpadeo = () => [
		{ autoAlpha: 1, scale: 1.25, duration: 0.12 },
		{ autoAlpha: 0.25, scale: 0.9, duration: 0.08 },
		{ autoAlpha: 1, scale: 1, duration: 0.2 },
	];

	/* Los tiempos de la timeline del escenario (en sus unidades; el total, 10, dura 3,6 pantallas). */
	const T = {
		paso2: 3.45, // cambia el indicador al paso 2
		paso3: 8.15, // y al paso 3
		fondo: 7.5, // el fondo empieza a pasar de papel a tinta…
		fondoDura: 0.9, // …y tarda esto; el texto cambia de color a mitad, mientras está apagado
	};
	const suave = gsap.parseEase("power1.inOut");

	if (root) {
		const mm = gsap.matchMedia();

		/* ── Escritorio: la sección se fija y el scroll cuenta los tres pasos ─────── */
		mm.add(ESCENA, () => {
			const stage = root.querySelector<HTMLElement>("[data-stage]");
			const board = root.querySelector<HTMLElement>("[data-board]");
			const editor = board?.querySelector<HTMLElement>("[data-editor]");
			const glow = board?.querySelector<HTMLElement>("[data-brillo]");
			const indice = root.querySelector<HTMLElement>("[data-step-index]");
			const clave = root.querySelector<HTMLElement>("[data-step-key]");
			const progreso = root.querySelector<HTMLElement>("[data-progress]");
			if (!stage || !board || !editor || !glow || !indice || !clave || !progreso) return;

			// Primero el atributo (la maquetación de escenario), luego las medidas y los tweens.
			root.dataset.pinned = "";

			const INK = canales("--ink");
			const PAPER = canales("--paper");
			const VOLT = canales("--volt");

			// La sección invierte --ink y --paper al encenderse; el editor conserva los suyos.
			editor.style.setProperty("--ink", INK.join(" "));
			editor.style.setProperty("--paper", PAPER.join(" "));

			const pasos = gsap.utils.toArray<HTMLElement>("[data-step]", root);
			const claves = pasos.map((p) => p.dataset.key ?? "");
			const dips = gsap.utils.toArray<Element>("[data-dip]", root);
			const pistas = board.querySelector("[data-pistas]");
			const trazos = board.querySelectorAll("[data-trazo]");
			const pads = board.querySelectorAll("[data-pad]");
			const etiquetas = board.querySelectorAll("[data-etiqueta]");
			const corriente = board.querySelector("[data-corriente]");
			const cabeza = editor.querySelector("[data-editor-head]");
			const ledEditor = editor.querySelector("[data-editor-led]");
			const hot = editor.querySelector("[data-code-hot]");
			const lineas = gsap.utils.toArray<HTMLElement>("[data-code-line]", editor);
			const textos = lineas.map((l) => l.querySelector("[data-code-text]")).filter((el): el is Element => !!el);
			const numeros = lineas.map((l) => l.querySelector("[data-code-num]")).filter((el): el is Element => !!el);

			// Estados iniciales. Opacidad y no autoAlpha en pasos y editor: siguen en el árbol de accesibilidad.
			gsap.set(trazos, { strokeDasharray: 1, strokeDashoffset: 1 });
			gsap.set([pads, etiquetas], { autoAlpha: 0 });
			gsap.set(pasos.slice(1), { opacity: 0, y: 24 });
			gsap.set(editor, { opacity: 0, clipPath: editor.dataset.desde });
			gsap.set(cabeza, { autoAlpha: 0 });
			gsap.set(textos, { clipPath: "inset(0% 100% 0% 0%)" });
			gsap.set(numeros, { opacity: 0 });
			gsap.set(ledEditor, { backgroundColor: rgba(VOLT, 0), boxShadow: `0 0 0em ${rgba(VOLT, 0)}` });
			if (corriente) gsap.set(corriente, { strokeDasharray: 1, strokeDashoffset: 1 });
			gsap.set(glow, { autoAlpha: 0, scale: 0.4 });
			gsap.set(progreso, { scaleX: 0 });

			// El fondo pasa de papel a tinta de forma continua; el texto y el acento cambian de golpe
			// a mitad de camino, mientras están apagados (data-dip), para no cruzarse nunca con el fondo.
			// Se calcula del tiempo de la timeline (no de un tween) para que un refresh nunca lo deje a medias.
			let encendido = -1;
			const pintar = (tiempo: number) => {
				const p = suave(gsap.utils.clamp(0, 1, (tiempo - T.fondo) / T.fondoDura));
				if (p === encendido) return;
				encendido = p;
				const on = p >= 0.5;
				root.style.setProperty("--paper", mezcla(PAPER, INK, p));
				root.style.setProperty("--ink", (on ? PAPER : INK).join(" "));
				root.style.setProperty("--o-acento", (on ? VOLT : INK).join(" "));
			};

			let activo = 0;
			const setProgreso = gsap.quickSetter(progreso, "scaleX");

			// El pin dura tres pantallas; la timeline arranca antes, cuando la sección asoma, para que
			// el esquema ya se esté dibujando al llegar, y acaba con el pin. `refreshPriority` hace que
			// el pin se mida antes que los demás triggers con la misma altura (los de la espina sobre
			// #sobre-mi), para que su `end` ya cuente las tres pantallas del pin.
			ScrollTrigger.create({
				trigger: stage,
				start: "top top",
				end: () => `+=${window.innerHeight * 3}`,
				pin: true,
				refreshPriority: 1,
				invalidateOnRefresh: true,
			});

			const tl = gsap.timeline({
				defaults: { ease: "none" },
				scrollTrigger: {
					trigger: root,
					start: "top 60%",
					end: () => `+=${window.innerHeight * 3.6}`,
					scrub: 0.8,
					invalidateOnRefresh: true,
				},
				onUpdate: () => {
					const tiempo = tl.time();
					const i = tiempo < T.paso2 ? 0 : tiempo < T.paso3 ? 1 : 2;
					if (i !== activo) {
						activo = i;
						indice.textContent = String(i + 1).padStart(2, "0");
						clave.textContent = claves[i] ?? "";
					}
					pintar(tiempo);
					setProgreso(tl.progress());
				},
			});

			// 1 · El circuito: trazos en el orden de la corriente, luego pads y referencias.
			tl.to(trazos, { strokeDashoffset: 0, duration: 0.6, stagger: { amount: 2.4 } }, 0)
				.to(pads, { autoAlpha: 1, duration: 0.2, stagger: { amount: 1.6 } }, 0.8)
				.to(etiquetas, { autoAlpha: 1, duration: 0.3, stagger: { amount: 1.2 } }, 1.5);

			// 2 · Del circuito al código: el chip se abre en el editor y las pistas se desvanecen.
			tl.to(pasos[0], { opacity: 0, y: -24, duration: 0.3, ease: "power1.in" }, 3.2)
				.to(pasos[1], { opacity: 1, y: 0, duration: 0.35, ease: "power2.out" }, 3.4)
				.to(pistas, { opacity: 0.14, duration: 0.7 }, 3.4)
				.to(editor, { opacity: 1, duration: 0.12 }, 3.5)
				.to(editor, { clipPath: "inset(0% 0% 0% 0%)", duration: 0.9, ease: "power3.inOut" }, 3.6)
				.to(cabeza, { autoAlpha: 1, duration: 0.25 }, 4.3);

			const porCaracter = 2 / Math.max(1, textos.reduce((s, el) => s + (el.textContent?.length ?? 0), 0));
			let en = 4.55;
			textos.forEach((texto, n) => {
				tl.to(numeros[n], { opacity: 1, duration: 0.01 }, en);
				en += teclear(tl, texto, en, porCaracter) + 0.02;
			});

			// 3 · Se enciende: la línea caliente, la corriente hasta el led, el led y el capítulo entero.
			tl.to(hot, { color: rgba(VOLT), duration: 0.15 }, 6.8)
				.to(
					ledEditor,
					{
						backgroundColor: rgba(VOLT),
						borderColor: rgba(VOLT),
						boxShadow: `0 0 0.8em ${rgba(VOLT, 0.8)}`,
						duration: 0.15,
					},
					6.8,
				)
				.to(corriente, { strokeDashoffset: 0, duration: 0.6, ease: "power1.inOut" }, 6.9)
				.to(pasos[1], { opacity: 0, y: -24, duration: 0.3, ease: "power1.in" }, 7.2)
				.to(glow, { keyframes: parpadeo() }, 7.45)
				// El fondo cambia entre T.fondo y T.fondo + T.fondoDura (lo pinta onUpdate); a mitad, todo apagado.
				.to(dips, { opacity: 0, duration: 0.25, ease: "power1.in" }, T.fondo + T.fondoDura / 2 - 0.25)
				.to(dips, { opacity: 1, duration: 0.3, ease: "power1.out" }, T.fondo + T.fondoDura / 2 + 0.05)
				.to(pistas, { opacity: 0.4, duration: 0.4 }, 8)
				.to(pasos[2], { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, 8.2)
				// Reposo: la composición encendida se queda quieta antes de soltar el pin.
				.to({}, { duration: 1.4 }, 8.6);

			return () => {
				delete root.dataset.pinned;
				for (const v of ["--ink", "--paper", "--o-acento"]) root.style.removeProperty(v);
				editor.style.removeProperty("--ink");
				editor.style.removeProperty("--paper");
				indice.textContent = "01";
				clave.textContent = claves[0] ?? "";
			};
		});

		/* ── Columna (móvil o pantalla baja): cada paso y su lámina entran al llegar ── */
		mm.add(COLUMNA, () => {
			for (const el of root.querySelectorAll<HTMLElement>("[data-step-text]")) {
				gsap.from(el.children, {
					y: 32,
					autoAlpha: 0,
					duration: 1.1,
					ease: EASE,
					stagger: 0.08,
					scrollTrigger: { trigger: el, start: "top 85%", once: true },
				});
			}

			// El esquema se dibuja con el scroll.
			const esquema = root.querySelector("[data-col-esquema]");
			if (esquema) {
				const st = { trigger: esquema, start: "top 85%", end: "bottom 55%", scrub: 0.6 };
				gsap.fromTo(
					esquema.querySelectorAll("[data-trazo]"),
					{ strokeDasharray: 1, strokeDashoffset: 1 },
					{ strokeDashoffset: 0, ease: "none", stagger: 0.05, scrollTrigger: st },
				);
				gsap.fromTo(
					esquema.querySelectorAll("[data-pad], [data-etiqueta]"),
					{ autoAlpha: 0 },
					{ autoAlpha: 1, ease: "none", stagger: 0.03, scrollTrigger: { ...st, start: "top 65%" } },
				);
			}

			// El código se teclea una vez al entrar.
			const codigo = root.querySelector("[data-col-codigo]");
			if (codigo) {
				const textos = codigo.querySelectorAll("[data-code-text]");
				gsap.set(textos, { clipPath: "inset(0% 100% 0% 0%)" });
				const tl = gsap.timeline({ scrollTrigger: { trigger: codigo, start: "top 75%", once: true } });
				let en = 0;
				textos.forEach((texto) => {
					en += teclear(tl, texto, en, 0.012) + 0.03;
				});
			}

			// La corriente llega al led y el led se enciende.
			const led = root.querySelector("[data-col-led]");
			const brillo = led?.querySelector("[data-brillo]");
			const corriente = led?.querySelector("[data-corriente]");
			if (led && brillo && corriente) {
				gsap.set(corriente, { strokeDasharray: 1, strokeDashoffset: 1 });
				gsap.set(brillo, { autoAlpha: 0, scale: 0.4 });
				gsap
					.timeline({ scrollTrigger: { trigger: led, start: "top 70%", once: true } })
					.to(corriente, { strokeDashoffset: 0, duration: 1.1, ease: "power2.inOut" })
					.to(brillo, { keyframes: parpadeo() }, "-=0.15");
			}
		});
	}
</script>
