---
import Magnetic from "@/components/motion/Magnetic.astro";
import RevealLines from "@/components/motion/RevealLines.astro";
import Roll from "@/components/motion/Roll.astro";
import SectionLabel from "@/components/motion/SectionLabel.astro";
import { PERFIL } from "@/data/perfil";
import { TEXTOS } from "@/data/textos";

const t = TEXTOS.contacto;
const palabras = t.titulo.antes.split(" ");
const mailto = `mailto:${PERFIL.email}`;
---

<!--
	Capítulo 05 · Contacto: llamada a la acción a pantalla completa, en papel.

	El titular se arma palabra a palabra desde la derecha mientras la sección entra (scrub,
	de `top bottom` a `bottom bottom`), y la pista de circuito se dibuja hasta el botón; el
	led del botón se enciende cuando la sección termina de entrar («power on»). Sin JS o con
	movimiento reducido: titular en su sitio, pista dibujada y led encendido.

	Tamaño del titular, medido con la fuente (Archivo 800 al 72 %): «¿CONSTRUIMOS ALGO» mide
	8,75 em y «¿CONSTRUIMOS» 6,41 em. Desde lg, 11cqw deja la primera línea al 96 % de la
	columna y «juntos?» baja a la derecha; por debajo, 14,5cqw deja «¿CONSTRUIMOS» al 93 %.
	En cqw y no en vw, para que nunca desborde (ver el pie).
-->
<section
	id="contacto"
	data-chapter="05"
	class="on-paper relative flex min-h-[100svh] flex-col overflow-x-clip bg-paper py-24 text-ink lg:py-32"
>
	<div class="shell flex flex-1 flex-col">
		<SectionLabel index="05" text="Contacto" />

		<div class="mt-16 [container-type:inline-size] lg:mt-20">
			<h2 class="display titular text-[length:14.5cqw] lg:text-[length:11cqw]">
				{
					palabras.map((palabra) => (
						<>
							<span data-word class="inline-block">
								{palabra}
							</span>{" "}
						</>
					))
				}
				<span class="lg:block lg:text-right"><em data-word class="accent inline-block">{t.titulo.acento}</em></span>
			</h2>
		</div>

		<div data-cta class="mt-auto grid grid-cols-12 gap-x-5 gap-y-16 pt-20 lg:items-end lg:pt-28">
			<div class="col-span-12 lg:col-span-5">
				<RevealLines as="p" class="max-w-[42ch] text-lg text-ink/70 md:text-xl">{t.texto}</RevealLines>
				<ul class="mt-10 flex flex-wrap gap-x-10 gap-y-5 text-label">
					<li>
						<a
							href={PERFIL.linkedin}
							target="_blank"
							rel="noopener noreferrer"
							class="group/sec inline-flex items-center gap-2 border-b border-ink/25 pb-2 transition-colors duration-500 hover:border-ink focus-visible:outline-ink"
						>
							<Roll text={t.linkedin} />
							<span
								aria-hidden="true"
								class="inline-block transition-transform duration-500 group-hover/sec:-translate-y-0.5 group-hover/sec:translate-x-0.5"
								>↗</span
							>
						</a>
					</li>
					<li>
						<a
							href={mailto}
							class="group/sec inline-flex items-center gap-2 border-b border-ink/25 pb-2 transition-colors duration-500 hover:border-ink focus-visible:outline-ink"
						>
							<Roll text={t.email} />
							<span
								aria-hidden="true"
								class="inline-block transition-transform duration-500 group-hover/sec:translate-x-1"
								>→</span
							>
						</a>
					</li>
				</ul>
			</div>

			<div class="col-span-12 flex items-center lg:col-span-6 lg:col-start-7">
				<!--
					La pista de circuito que lleva la corriente hasta el botón: vía, tramo largo,
					quiebro a 45° y tramo corto. Va 12 px por debajo del centro hasta el quiebro,
					que la sube al centro del botón.
				-->
				<div aria-hidden="true" class="flex min-w-0 flex-1 items-center text-ink/40">
					<div class="flex min-w-0 flex-1 translate-y-3 items-center">
						<span class="size-[7px] shrink-0 rounded-full border border-current"></span>
						<span data-trace-line class="h-px min-w-6 flex-1 origin-left bg-current"></span>
					</div>
					<svg viewBox="0 0 24 24" fill="none" class="h-6 w-6 shrink-0 overflow-visible">
						<path
							data-trace-jog
							d="M0 24 L12 12 H24"
							stroke="currentColor"
							stroke-width="1"
							vector-effect="non-scaling-stroke"
							pathLength="1"></path>
					</svg>
					<span data-trace-end class="h-px w-6 shrink-0 origin-left bg-current md:w-10"></span>
				</div>

				<Magnetic strength={0.35} class="shrink-0">
					<a
						href={mailto}
						class="group/cta relative grid size-40 place-items-center overflow-hidden rounded-full border border-ink focus-visible:outline-ink md:size-48 lg:size-56"
					>
						<!-- El relleno entra desde abajo al pasar el ratón (o con el foco). -->
						<span
							aria-hidden="true"
							class="absolute inset-0 translate-y-full rounded-[50%] bg-ink transition-transform duration-700 ease-[cubic-bezier(0.19,1,0.22,1)] group-hover/cta:translate-y-0 group-focus-visible/cta:translate-y-0 motion-reduce:transition-none"
						></span>
						<span
							class="relative flex flex-col items-center gap-5 text-label transition-colors duration-500 group-hover/cta:text-paper group-focus-visible/cta:text-paper"
						>
							<span data-led aria-hidden="true" class="led led-pulse power"></span>
							<Roll text={t.boton} />
						</span>
					</a>
				</Magnetic>
			</div>
		</div>
	</div>
</section>

<style>
	/* Interlineado de text-huge con el tamaño en cqw. */
	.titular {
		line-height: 0.88;
	}

	/* El led del botón, algo mayor que el de serie. Apagado es una vía hueca; al encenderse
	   se rellena de amarillo con su halo. */
	.power {
		width: 0.625rem;
		height: 0.625rem;
		transition:
			background-color 0.35s ease,
			box-shadow 0.6s ease;
	}
	.power[data-off] {
		background-color: transparent;
		box-shadow: inset 0 0 0 1px currentColor;
		animation: none;
	}
</style>

<script>
	import { MQ, gsap } from "@/scripts/motion";

	const root = document.querySelector<HTMLElement>("#contacto");
	if (root) initContacto(root);

	function initContacto(root: HTMLElement) {
		const words = root.querySelectorAll<HTMLElement>("[data-word]");
		const cta = root.querySelector<HTMLElement>("[data-cta]");
		const line = root.querySelector<HTMLElement>("[data-trace-line]");
		const jog = root.querySelector<SVGPathElement>("[data-trace-jog]");
		const end = root.querySelector<HTMLElement>("[data-trace-end]");
		const led = root.querySelector<HTMLElement>("[data-led]");

		const power = (on: boolean) => {
			if (!led) return;
			if (on) delete led.dataset.off;
			else led.dataset.off = "";
		};

		const mm = gsap.matchMedia();
		mm.add(MQ.motion, () => {
			// Cada palabra llega desde más lejos que la anterior y se asienta cuando la sección
			// llena la pantalla. Recorrido en función del ancho: se vuelve a medir en cada refresh.
			gsap.from(words, {
				x: (i: number) => window.innerWidth * (0.08 + i * 0.12),
				ease: "none",
				scrollTrigger: {
					trigger: root,
					start: "top bottom",
					end: "bottom bottom",
					scrub: true,
					invalidateOnRefresh: true,
				},
			});

			// La pista se dibuja desde que asoma el bloque de abajo hasta que la sección termina
			// de entrar; justo entonces se enciende el led, y se apaga si se vuelve atrás.
			power(false);
			if (cta && line && jog && end) {
				gsap
					.timeline({
						defaults: { ease: "none" },
						scrollTrigger: {
							trigger: cta,
							start: "top bottom",
							endTrigger: root,
							end: "bottom bottom",
							scrub: true,
							invalidateOnRefresh: true,
							onUpdate: (self) => power(self.progress > 0.99),
							onRefresh: (self) => power(self.progress > 0.99),
						},
					})
					.from(line, { scaleX: 0, duration: 0.6 })
					.fromTo(jog, { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.15 })
					.from(end, { scaleX: 0, duration: 0.25 });
			}

			return () => power(true);
		});
	}
</script>
