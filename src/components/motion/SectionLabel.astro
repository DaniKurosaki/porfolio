---
/**
 * La etiqueta que abre cada capítulo: «(02) Origen ────────○». El filete es una pista de
 * circuito que se dibuja al entrar y acaba en una vía.
 */
interface Props {
	index: string;
	text: string;
	class?: string;
}

const { index, text, class: className } = Astro.props;
---

<div class:list={["text-label flex items-center gap-4", className]} data-section-label>
	<span class="tabular-nums">({index})</span>
	<span>{text}</span>
	<span data-rule class="h-px flex-1 origin-left bg-current opacity-30"></span>
	<span class="size-[7px] shrink-0 rounded-full border border-current opacity-60"></span>
</div>
