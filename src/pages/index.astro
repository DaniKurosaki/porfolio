---
import Layout from "@/layouts/Layout.astro";
import { TEXTOS } from "@/data/textos";

import Hero from "@/components/sections/Hero.astro";
import Manifiesto from "@/components/sections/Manifiesto.astro";
import Origen from "@/components/sections/Origen.astro";
import Trayectoria from "@/components/sections/Trayectoria.astro";
import Stack from "@/components/sections/Stack.astro";
import Proyectos from "@/components/sections/Proyectos.astro";
import Contacto from "@/components/sections/Contacto.astro";
---

<!-- Una historia en cinco capítulos: del circuito al código. -->
<Layout title={TEXTOS.meta.titulo} description={TEXTOS.meta.descripcion}>
	<Hero />
	<Manifiesto />
	<Origen />
	<Trayectoria />
	<Stack />
	<Proyectos />
	<Contacto />
</Layout>
